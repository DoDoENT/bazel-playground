load("//macros:mobile_binary.bzl", "mobile_binary" )
load("//macros:mobile_test.bzl", "mobile_test" )
load("//macros:test_suite.bzl", "define_test_suites" )
load("@rules_qt//:qt.bzl", "qt_cc_binary", "qt_cc_test")

define_test_suites(
    name = "test-suites",
)

mobile_test(
    name = "image-manipulation-test",
    srcs = [
        "image-manipulation.cc",
    ],
    data = [
        "test-data/image.png",
        "test-data/expected-result.png",
    ],
    deps = [
        "@opencv//:imgcodecs",
    ],
    android_deploy_resources = True,
    wasm_basic = False,  # OpenCV 5.0.0 fails to build without WASM SIMD
)

qt_cc_test(
    name = "qt-integration-test",
    srcs = ["qt-integration-test.cc"],
    env = {
        # fontconfig retains process-global allocations that LeakSanitizer
        # otherwise reports when Qt initializes its font database.
        "LSAN_OPTIONS": "detect_leaks=0",
        "QT_QPA_PLATFORM": "offscreen",
    },
    tags = ["host"],
    deps = [
        "@opencv//:core",
        "@opencv//:highgui",
    ],
)

qt_cc_binary(
    name = "displayImage",
    srcs = ["displayImage.cc"],
    data = [
        "test-data/image.png",
    ],
    deps = [
        "@opencv//:highgui",
    ],
    tags = ["host"],
    visibility = ["//visibility:public"],
)

mobile_binary(
    name = "cameraTest",
    srcs = [
        "cameraTest.cc",
    ],
    deps = [
        "@opencv//:highgui",
    ],
    host_only = True,
    visibility = ["//visibility:public"],
)
