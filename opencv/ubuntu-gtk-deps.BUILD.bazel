cc_import(
    name = "gdk_pixbuf",
    shared_library = select({
        "@platforms//cpu:x86_64": "usr/lib/x86_64-linux-gnu/libgdk_pixbuf-2.0.so.0",
        "@platforms//cpu:aarch64": "usr/lib/aarch64-linux-gnu/libgdk_pixbuf-2.0.so.0",
    }),
    hdrs = glob(["usr/include/gdk-pixbuf-2.0/**/*.h"]),
    strip_include_prefix = "usr/include/gdk-pixbuf-2.0",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
