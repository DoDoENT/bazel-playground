alias(
    name = "gio",
    actual = "@glib//gio",
)

alias(
    name = "gobject",
    actual = "@glib//gobject",
)

alias(
    name = "glib",
    actual = "@glib//glib",
)

alias(
    name = "gmodule",
    actual = "@glib//gmodule",
)

# GLib moved threading into libglib in 2.32. Old Pango still names this
# compatibility DSO, which forwards to the shared GLib built below.
cc_import(
    name = "gthread",
    shared_library = select({
        "@platforms//cpu:x86_64": "usr/lib/x86_64-linux-gnu/libgthread-2.0.so.0",
        "@platforms//cpu:aarch64": "usr/lib/aarch64-linux-gnu/libgthread-2.0.so.0",
    }),
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":glib"],
)

# Keep BCR's GLib targets unmodified. The final executable uses these through
# dynamic_deps so HarfBuzz and the prebuilt GTK stack share the same GLib.
cc_shared_library(
    name = "glib_shared",
    deps = ["@glib//glib"],
    shared_lib_name = "libglib-2.0.so.0",
    target_compatible_with = ["@platforms//os:linux"],
    user_link_flags = ["-Wl,-soname,libglib-2.0.so.0"],
)

cc_shared_library(
    name = "gobject_shared",
    deps = ["@glib//gobject"],
    dynamic_deps = [":glib_shared"],
    shared_lib_name = "libgobject-2.0.so.0",
    target_compatible_with = ["@platforms//os:linux"],
    user_link_flags = ["-Wl,-soname,libgobject-2.0.so.0"],
)

cc_shared_library(
    name = "gmodule_shared",
    deps = ["@glib//gmodule"],
    dynamic_deps = [":glib_shared"],
    shared_lib_name = "libgmodule-2.0.so.0",
    target_compatible_with = ["@platforms//os:linux"],
    user_link_flags = ["-Wl,-soname,libgmodule-2.0.so.0"],
)

cc_shared_library(
    name = "zlib_shared",
    deps = ["@zlib//:zlib"],
    shared_lib_name = "libz.so.1",
    target_compatible_with = ["@platforms//os:linux"],
    user_link_flags = ["-Wl,-soname,libz.so.1"],
)

cc_shared_library(
    name = "gio_shared",
    deps = ["@glib//gio"],
    dynamic_deps = [
        ":glib_shared",
        ":gobject_shared",
        ":gmodule_shared",
        ":zlib_shared",
    ],
    shared_lib_name = "libgio-2.0.so.0",
    target_compatible_with = ["@platforms//os:linux"],
    user_link_flags = ["-Wl,-soname,libgio-2.0.so.0"],
)
